    "SecretKey": "SUPER_SECURE_JWT_SECRET_KEY_FOR_PRODUCTION_SCALING_32BYTES_LONG",
    "Issuer": "ecommerce-api",
    "Audience": "ecommerce-web"
  },
  "Payment": {
    "GatewaySecret": "MOCK_PAYMENT_SECRET_KEY_123456789"
  }
}
